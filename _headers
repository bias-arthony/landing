# Filenames here are never content-hashed (no build step), so a long max-age
# means a visitor keeps running stale code after a deploy. Revalidate instead:
# the browser sends If-None-Match and usually gets a cheap 304.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Media changes rarely and is safe to hold onto for a day.
/assets/*
  Cache-Control: public, max-age=86400

# Serve the profile files as real JSON so `curl` gets the right type.
/api/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
